# ============================================================================
#  暗区突围 · 改枪码分享站  ——  后端环境变量模板
#
#  用法：复制为 .env 后填入真实值。`.env` 已在 .gitignore 中，不要提交。
#      cp .env.example .env
#
#  ⚠️ 启动即校验：src/lib/env.ts 用 zod 校验以下变量，
#     缺失或非法会直接 `process.exit(1)`，而不是运行到一半才 500。
# ============================================================================

# ---------------------------------------------------------------- 运行环境
NODE_ENV=production
PORT=3000

# 允许的前端来源，多个用逗号分隔。
# ⚠️ 生产环境**必须**改成真实前端域名，否则浏览器会因 CORS 被拦；
#    留默认值 http://localhost:5173 会让线上前端完全调不通接口。
# ⚠️ 生产环境禁止使用 *（代码里检测到会自动降级为"仅同源"，等于全站不可用）。
CORS_ORIGIN=https://anqu.example.com,https://www.anqu.example.com

# ---------------------------------------------------------------- 数据库
# Supabase 控制台 → Project Settings → Database → Connection string
#
# 【DATABASE_URL】应用运行时使用，走 Supabase 连接池（端口 6543）。
#   ⚠️ 参数名是 `pgbouncer`（不是 pgbouncer 之外的任何拼写）。
#      它的作用是让 Prisma 关闭预处理语句 —— 事务级连接池不支持跨语句的
#      prepared statement，不设置会在并发下随机报
#      "prepared statement already exists" 之类的错。
#   ⚠️ `connection_limit=1` 在 Serverless 场景很重要：每个实例只占一条连接，
#      否则实例一多就把 Supabase 的连接数打满。
DATABASE_URL="postgresql://postgres.<project-ref>:<password>@aws-0-ap-southeast-1.pooler.supabase.com:6543/postgres?pgbouncer=true&connection_limit=1"

# 【DIRECT_URL】仅供 `prisma db pull` / 迁移使用，走直连端口 5432。
#   连接池的会话态不可靠，schema 内省必须用直连。
DIRECT_URL="postgresql://postgres.<project-ref>:<password>@aws-0-ap-southeast-1.pooler.supabase.com:5432/postgres"

# ---------------------------------------------------------------- Supabase API
# Project Settings → API
SUPABASE_URL=https://<project-ref>.supabase.co

# 用于校验前端传来的 JWT（auth.getUser）。这是**必填**项，
# 缺失会导致进程启动失败。anon key 本身是公开的，放在后端只是复用它做校验。
SUPABASE_ANON_KEY=<anon-public-key>

# 可选。持有它即可绕过 RLS，**只能存在于服务端环境变量**，
# 严禁写入任何 VITE_ 前缀的变量（那会被打进前端产物）。
# 不配置时 supabaseAdmin 为 null，后台管理类功能不可用，但不影响主流程。
SUPABASE_SERVICE_ROLE_KEY=<service-role-key>

# ---------------------------------------------------------------- 说明
# 关于 SUPABASE_JWT_SECRET：
#   本项目**不使用**该变量。令牌校验走的是 `supabaseAuth.auth.getUser(token)`
#   （anon key 调用 Supabase Auth API），而不是在本地用 JWT secret 验签。
#   因此无需配置，也避免多一处密钥泄露面。
#
#   这样做的代价是每个请求多一次对 Supabase 的网络往返；
#   好处是密钥轮换、令牌吊销都由 Supabase 统一负责，本地无状态。
#   若后续要做本地验签以降低延迟，再引入 SUPABASE_JWT_SECRET 即可。
