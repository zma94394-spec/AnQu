# 构建镜像时排除的文件。
# 目标：镜像里只保留运行必需的 src/dist/prisma/package*，其余一律不进构建上下文。

node_modules
dist

# 环境变量：绝不能进镜像层。运行期通过 --env-file 或平台变量注入。
.env
.env.*
!.env.example

# 前端工程与后端镜像无关
web

# 测试与本地脚本
tests
scripts

# 文档与编辑器
*.md
!README.md
.git
.gitignore
.vscode
.idea

# 日志与杂项
*.log
npm-debug.log*
.DS_Store
coverage
