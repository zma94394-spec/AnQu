{
  "name": "anqu-builds-api",
  "version": "1.0.0",
  "private": true,
  "description": "暗区突围 · 改枪码分享站 API（Express + Prisma + Supabase PostgreSQL）",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/server.js",
    "postinstall": "prisma generate",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "check:sql": "python scripts/check_sql.py",
    "test:db": "node --test",
    "prisma:generate": "prisma generate",
    "prisma:pull": "prisma db pull",
    "db:apply": "psql \"$DATABASE_URL\" -v ON_ERROR_STOP=1 -f db/01_schema.sql -f db/03_functions.sql -f db/02_rls.sql -f db/04_seed.sql",
    "db:apply:selfhosted": "psql \"$DATABASE_URL\" -v ON_ERROR_STOP=1 -f db/00_auth_shim.sql -f db/01_schema.sql -f db/03_functions.sql -f db/02_rls.sql -f db/04_seed.sql",
    "db:deploy": "bash scripts/deploy_db.sh",
    "db:migrate": "node --import tsx scripts/apply_migrations.mts"
  },
  "dependencies": {
    "@prisma/client": "^5.22.0",
    "@supabase/supabase-js": "^2.45.4",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.21.1",
    "express-rate-limit": "^7.4.1",
    "helmet": "^8.0.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.8",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/node": "^22.7.5",
    "@types/pg": "^8.23.1",
    "pg": "^8.23.0",
    "prisma": "^5.22.0",
    "tsx": "^4.19.1",
    "typescript": "^5.6.3"
  }
}
