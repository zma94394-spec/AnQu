{
  "name": "anqu-builds-web",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "暗区突围 · 改枪码分享站 —— 前端（React + Tailwind CSS + Lucide Icons）",
  "scripts": {
    "dev": "vite",
    "prebuild": "npm run check:env",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview --port 4173",
    "typecheck": "tsc --noEmit",
    "check:env": "tsx scripts/check-env.mts",
    "check:validation": "tsx scripts/check-validation-parity.mts",
    "check:mocks": "tsx scripts/check-mocks.mts"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.117.0",
    "lucide-react": "^0.454.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.30.6"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.0.0",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.3",
    "tailwindcss": "^4.0.0",
    "tsx": "^4.19.1",
    "typescript": "^5.6.3",
    "vite": "^5.4.11"
  }
}
