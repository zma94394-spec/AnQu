# ============================================================================
#  暗区突围 · 改枪库前端  ——  生产环境变量
#
#  Vite 在 `npm run build` 时加载本文件（mode=production），
#  并把所有 `VITE_` 前缀的变量**内联进 JS 产物**。
#
#  ⚠️ 因此：凡是 VITE_ 开头的值都是公开的，任何人都能在 bundle 里读到。
#     绝不要把 service_role key、数据库连接串、任何私钥写进这里。
#     anon key 放在这里是安全的 —— 它的权限受 RLS 约束，本就是设计为公开的。
#
#  ⚠️ 优先级：执行构建时**已存在的环境变量优先**，不会被本文件覆盖。
#     所以在 Vercel / Cloudflare Pages 控制台里配置同名变量即可生效，
#     本文件只作为本地构建与文档参考。
# ============================================================================

# 后端 API 地址。留空则走同域相对路径 /api（适用于前后端同域 + 反向代理）。
# 前后端分域部署时必须填完整地址，且后端 CORS_ORIGIN 要包含前端域名。
VITE_API_BASE_URL="https://api.anqu.example.com"

# Supabase 项目地址与 anon key（Project Settings → API）
VITE_SUPABASE_URL="https://jiwatwrcseiptnowsxti.supabase.co/rest/v1/"
VITE_SUPABASE_ANON_KEY="<eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpc3MiOiJzdXBhYmFzZSIsInJlZiI6Imppd2F0d3Jjc2VpcHRub3dzeHRpIiwicm9sZSI6ImFub24iLCJpYXQiOjE3OTAwODU3NDQsImV4cCI6MjEwNTY2MTc0NH0.zV6xV10ONiNOCy68AQg0wZovSxK_b6jxRGpv2hjjxTM>"

# Mock 数据开关。
# ⚠️ 生产环境必须是 false 或不设置 —— 设为 true 会完全绕过后端接口，
#    用户看到的是写死的演示数据，且点赞/评论都不会落库。
VITE_USE_MOCK=false
