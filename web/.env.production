# ============================================================================
#  暗区突围 · 改枪库前端  ——  生产环境变量
#
#  Vite 在 `npm run build` 时加载本文件（mode=production），
#  并把所有 `VITE_` 前缀的变量**内联进 JS 产物**。
#
#  ⚠️ 凡是 VITE_ 开头的值都是公开的，任何人都能在 bundle 里读到。
#     绝不要把 service_role key、数据库连接串、任何私钥写进这里。
#     anon key 放在这里是安全的 —— 它的权限受 RLS 约束，本就是设计为公开的。
#
#  ⚠️ 优先级：执行构建时**已存在的环境变量优先**，不会被本文件覆盖。
#     所以在 Vercel / Cloudflare Pages 控制台里配置同名变量即可生效。
# ============================================================================

# ---------------------------------------------------------------- 后端 API
# Render 上的后端服务地址。
# ⚠️ 不要带结尾斜杠 —— 代码里是 `${API_BASE}${path}` 拼接，
#    多一个斜杠会变成 https://anqu.onrender.com//api/guns，部分网关会 404。
VITE_API_BASE_URL="https://anqu.onrender.com"

# ---------------------------------------------------------------- Supabase
# ⚠️ 必须是**项目根地址**，不能带 /rest/v1/ 之类的路径后缀。
#    supabase-js 会在根地址后面自行拼 /auth/v1/... 与 /rest/v1/...，
#    写成 .../rest/v1/ 会得到 .../rest/v1//auth/v1/token → 404 → 登录必然失败。
#
#    错误示例：https://xxx.supabase.co/rest/v1/      ← 这是 REST 端点，不是项目地址
#    正确写法：https://xxx.supabase.co
VITE_SUPABASE_URL="https://jiwatwrcseiptnowsxti.supabase.co"

# ⚠️ 直接粘贴 key 本身，**不要**用尖括号包裹。
#    写成 <eyJ...> 会让 key 多出两个字符，Supabase 会判为非法令牌。
VITE_SUPABASE_ANON_KEY="eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpc3MiOiJzdXBhYmFzZSIsInJlZiI6Imppd2F0d3Jjc2VpcHRub3dzeHRpIiwicm9sZSI6ImFub24iLCJpYXQiOjE3OTAwODU3NDQsImV4cCI6MjEwNTY2MTc0NH0.zV6xV10ONiNOCy68AQg0wZovSxK_b6jxRGpv2hjjxTM"

# ---------------------------------------------------------------- Mock 开关
# ⚠️ 生产环境必须是 false 或不设置 —— 设为 true 会完全绕过后端接口，
#    用户看到的是写死的演示数据，且点赞/评论都不会落库。
VITE_USE_MOCK=false
