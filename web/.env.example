# ============================================================================
#  暗区突围 · 改枪库前端  ——  环境变量速查
#
#  实际生效的文件按 Vite 约定：
#    .env.development   本地开发（npm run dev）
#    .env.production    生产构建（npm run build）
#
#  本文件仅作说明，不会被 Vite 加载。
# ============================================================================

# ---------------------------------------------------------------- 本地开发
# web/.env.development
VITE_USE_MOCK=true
# 后端未启动时用内置演示数据渲染，界面右上角会显示 MOCK 标记。
# 与后端联调时改为 false，请求经 vite.config.ts 的 proxy 转发到 127.0.0.1:3000。

# ---------------------------------------------------------------- 生产构建
# web/.env.production
VITE_API_BASE_URL="https://api.example.com"
VITE_SUPABASE_URL="https://<project-ref>.supabase.co"
VITE_SUPABASE_ANON_KEY="<anon-public-key>"
VITE_USE_MOCK=false

# ---------------------------------------------------------------- 安全边界
# VITE_ 前缀的变量会被**内联进 JS 产物**，等于公开发布。允许：
#   · SUPABASE_ANON_KEY  —— 权限受 RLS 约束，本就设计为公开
#   · 后端 API 域名
# 严禁：
#   · SUPABASE_SERVICE_ROLE_KEY（可绕过 RLS，一旦泄露等于交出数据库）
#   · DATABASE_URL / DIRECT_URL（数据库凭据）
#   · 任何私钥或第三方密钥

# ---------------------------------------------------------------- 部署平台
# Vercel / Cloudflare Pages 在控制台配置同名变量即可，会覆盖 .env.production。
# 构建前可运行 `npm run check:env` 自检是否漏填或误填。
